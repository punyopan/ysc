flowchart TB
    A[Thai test source<br/>genuine or spoof] --> DEC
    A --> SW

    subgraph DEC [Decomposition set — attribution]
        direction TB
        C0[C0: clean<br/>16 kHz linear PCM]
        C1[C1: 8 kHz LINEAR PCM<br/>bandwidth only, no companding]
        C2[C2: G.711 μ-law<br/>bandwidth + companding]
        C3[C3: G.711 A-law<br/>bandwidth + companding]
    end

    subgraph SW [Sweep set — dose-response, fixed 16 kHz throughout]
        direction LR
        S1[No filter<br/>16 kHz reference] --- S2[6000 Hz] --- S3[4000] --- S4[3400] --- S5[2500] --- S6[1500] --- S7[800]
    end

    DEC --> D[Frozen detectors<br/>LFCC-GMM · AASIST-L · AASIST<br/>+ WavLM+AASIST, optional]
    SW --> D

    D --> E[Paired source-level scores]

    E --> R1[ATTRIBUTION<br/>bandwidth part = C1 − C0<br/>companding part = G711 − C1]
    E --> R2[DOSE-RESPONSE<br/>EER vs cutoff curve<br/>collapse thresholds]
    E --> R4[Threshold-transfer check<br/>secondary, follows ref 19]

    AUG[AASIST-L retrained with<br/>band-limited augmentation] --> R3[MITIGATION<br/>recovery fraction<br/>+ cost on clean audio]
    E --> R3

    classDef source fill:#e0f2fe,stroke:#0369a1,color:#0c4a6e;
    classDef condition fill:#fef3c7,stroke:#b45309,color:#78350f;
    classDef control fill:#ffedd5,stroke:#c2410c,color:#7c2d12;
    classDef detector fill:#ede9fe,stroke:#6d28d9,color:#3b0764;
    classDef analysis fill:#dcfce7,stroke:#15803d,color:#14532d;
    classDef primary fill:#fee2e2,stroke:#b91c1c,color:#7f1d1d;
    class A source;
    class C0,C2,C3,S1,S2,S3,S4,S5,S6,S7 condition;
    class C1 control;
    class D,AUG detector;
    class E,R4 analysis;
    class R1,R2,R3 primary;
