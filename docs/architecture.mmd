flowchart TB
    A[Thai test source<br/>genuine or spoof] --> C0[C0: clean<br/>16 kHz PCM]
    A --> C1[C1: bandwidth control<br/>8 kHz linear PCM]
    A --> C2[C2: G.711 μ-law<br/>8 kHz round trip]
    A --> C3[C3: G.711 A-law<br/>8 kHz round trip]

    C0 --> D[Four frozen detector families]
    C1 --> D
    C2 --> D
    C3 --> D

    D --> E[Paired source-level scores]

    E --> F[ΔEER with paired<br/>cluster-bootstrap intervals]
    E --> G[Clean-development threshold transfer<br/>FPR, FNR and balanced accuracy<br/>with no channel retuning]
    E --> H[Clean versus G.711<br/>rank stability]

    classDef source fill:#e0f2fe,stroke:#0369a1,color:#0c4a6e;
    classDef condition fill:#fef3c7,stroke:#b45309,color:#78350f;
    classDef detector fill:#ede9fe,stroke:#6d28d9,color:#3b0764;
    classDef analysis fill:#dcfce7,stroke:#15803d,color:#14532d;
    class A source;
    class C0,C1,C2,C3 condition;
    class D detector;
    class E,F,G,H analysis;
